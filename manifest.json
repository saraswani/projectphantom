{
  "manifest_version": 3,
  "name": "Phantom AI",
  "version": "0.8.1",
  "description": "Local privacy-preserving vision agent for all Web Browsers Redacts PII, faces, and sensitive screen data locally before VLM inference.",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Phantom AI — Site Threat Analysis",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "permissions": [
    "activeTab",
    "tabs",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "config.js",
        "lib/browser-polyfill.js",
        "lib/pii/verhoeff.js",
        "lib/pii/luhn.js",
        "lib/pii/regex-rules.js",
        "lib/pii/text-detector.js",
        "lib/vision/tf.min.js",
        "lib/vision/blazeface.min.js",
        "lib/vision/face-detector.js",
        "lib/vision/tesseract/tesseract.min.js",
        "lib/vision/ocr-worker.js",
        "lib/vision/screen-analyzer.js",
        "lib/vision/ort/ort.all.min.js",
        "lib/vision/screen-vit.js",
        "lib/decision/threat-score.js",
        "lib/decision/local-decision-engine.js",
        "lib/redactor/dom-redactor.js",
        "lib/redactor/canvas-redactor.js",
        "lib/privacy/privacy-gate.js",
        "lib/executor/action-validator.js",
        "lib/executor/action-executor.js",
        "lib/telemetry/instrumentation.js",
        "content.js",
        "lib/redactor/manual-redact.js"
      ],
      "css": [
        "styles/floating-shield.css",
        "styles/panel.css",
        "styles/manual-redact.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "lib/pii/ner-worker.js",
        "lib/vision/vision-worker.js",
        "lib/vision/tesseract/*",
        "lib/vision/ort/*",
        "lib/vision/model/*",
        "lib/vision/models/*",
        "icons/*",

        "styles/*"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "privacyshield@isro-sih.org",
      "strict_min_version": "109.0"
    }
  }
}
