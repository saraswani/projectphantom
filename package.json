{
  "name": "privacyshield-extension",
  "version": "1.0.0",
  "description": "PrivacyShield: A Privacy-Preserving Vision Agent for Chrome and Firefox (Manifest V3)",
  "scripts": {
    "generate-icons": "node generate-icons.js",
    "test": "node test/evaluate.js && node test/test-form-filling.js",
    "test:form": "node test/test-form-filling.js",
    "test:privacy": "node evaluation/privacy/network-leak-test.js",
    "test:security": "node evaluation/security/security-suite.js",
    "benchmark": "node evaluation/run-all.js",
    "evaluate:all": "npm test && npm run test:privacy && npm run test:security && npm run benchmark",
    "start-server": "node server/server.js"
  },
  "keywords": [
    "privacy",
    "vision-agent",
    "chrome-extension",
    "firefox-extension",
    "manifest-v3",
    "pii-redaction",
    "sih"
  ],
  "author": "PrivacyShield Team",
  "license": "MIT",
  "dependencies": {
    "@tensorflow-models/blazeface": "^0.1.0",
    "@tensorflow/tfjs": "^4.22.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "onnxruntime-web": "^1.30.0",
    "pngjs": "^7.0.0",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  }
}
